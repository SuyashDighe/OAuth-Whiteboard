# Application Environment: 'development', 'staging', or 'production'
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Connection URL:
# For local SQLite development (async):
DATABASE_URL=sqlite+aiosqlite:///./oauth_whiteboard.db
# For production PostgreSQL (async):
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/oauth_whiteboard

# Cryptographic Secret for State Signing & Session Verification (at least 32 characters):
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=insecure-dev-secret-key-change-in-production-abcdef123456

# Primary Fernet Key for OAuth Token Encryption at Rest (url-safe base64-encoded 32 bytes):
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=dGVzdF9mZXJuZXRfa2V5XzMyX2J5dGVzX2xvbmdfMTIzNDU2Nzg=

# Comma-separated previous keys for seamless key rotation (optional):
# ROTATION_ENCRYPTION_KEYS=old_key_1,old_key_2

# Google OAuth 2.0 Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google/callback

# Default User ID for local development and non-authenticated header simulation
DEFAULT_USER_ID=user_dev_01
